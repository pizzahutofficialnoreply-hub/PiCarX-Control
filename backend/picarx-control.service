[Unit]
Description=PiCar X Control API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/PiCarX-Control/backend
Environment=PICARX_MODE=mock
ExecStart=/home/pi/PiCarX-Control/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
